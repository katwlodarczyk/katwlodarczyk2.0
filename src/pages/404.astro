---
import Layout from "../layouts/Layout.astro";
import { getSortedPosts } from "../lib/blog";

const latestPosts = (await getSortedPosts()).slice(0, 3);
---

<Layout title="Page not found — Kat Wlodarczyk" description="This page went for a run and didn't come back.">
  <section class="max-w-5xl mx-auto px-4 md:px-6 py-16 md:py-24">
    <div class="flex flex-col md:flex-row items-center gap-10 md:gap-16">
      <!-- Lost robot -->
      <svg
        class="w-56 md:w-72 shrink-0 lost-robot"
        viewBox="0 0 300 330"
        xmlns="http://www.w3.org/2000/svg"
        role="img"
        aria-label="A confused robot looking at a map"
      >
        <defs>
          <linearGradient id="robot-body" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#8b8ac9" />
            <stop offset="1" stop-color="#6564a8" />
          </linearGradient>
        </defs>
        <ellipse cx="150" cy="318" rx="95" ry="10" fill="#7675B9" opacity=".15" />
        <!-- question marks -->
        <text x="232" y="62" font-family="Permanent Marker, cursive" font-size="44" fill="#FF8FBB" transform="rotate(14 232 62)">?</text>
        <text x="40" y="92" font-family="Permanent Marker, cursive" font-size="30" fill="#7675B9" transform="rotate(-12 40 92)">?</text>
        <g transform="rotate(-8 150 140)">
          <!-- antenna, bent -->
          <path d="M150 52 q6 -22 22 -26" stroke="#5a59a0" stroke-width="8" fill="none" stroke-linecap="round" />
          <circle cx="176" cy="24" r="14" fill="#FF8FBB" />
          <!-- ears -->
          <rect x="34" y="104" width="26" height="62" rx="11" fill="#5a59a0" />
          <rect x="240" y="104" width="26" height="62" rx="11" fill="#5a59a0" />
          <!-- head -->
          <rect x="52" y="52" width="196" height="166" rx="56" fill="url(#robot-body)" />
          <rect x="80" y="84" width="140" height="102" rx="38" fill="#25244a" />
          <!-- eyes: one big, one small -->
          <circle cx="122" cy="128" r="13" fill="#9ff0d6" />
          <circle cx="180" cy="130" r="8" fill="#9ff0d6" />
          <!-- wobbly mouth -->
          <path d="M126 164 q8 -8 16 0 t16 0 t16 0" stroke="#9ff0d6" stroke-width="6" fill="none" stroke-linecap="round" />
        </g>
        <!-- body -->
        <rect x="88" y="214" width="124" height="92" rx="36" fill="url(#robot-body)" />
        <!-- map held upside down -->
        <g transform="rotate(6 150 262)">
          <path d="M92 232 l40 -10 l36 10 l40 -10 v70 l-40 10 l-36 -10 l-40 10 z" fill="#fff" stroke="#d9d8ee" stroke-width="3" />
          <path d="M132 222 v70 M168 232 v70" stroke="#d9d8ee" stroke-width="3" />
          <path d="M104 282 q20 -30 46 -10 t48 -24" stroke="#FF8FBB" stroke-width="4" fill="none" stroke-dasharray="6 6" stroke-linecap="round" />
          <path d="M190 240 l8 8 m0 -8 l-8 8" stroke="#7675B9" stroke-width="4" stroke-linecap="round" />
        </g>
        <circle cx="96" cy="266" r="16" fill="#5a59a0" />
        <circle cx="206" cy="258" r="16" fill="#5a59a0" />
      </svg>

      <div class="text-center md:text-left">
        <p class="font-display text-7xl md:text-8xl text-primary leading-none mb-4">404</p>
        <h1 class="text-2xl md:text-3xl font-display text-foreground mb-3">
          <span class="text-highlight">This page went for a run</span>
        </h1>
        <p class="text-muted-foreground mb-8 max-w-md">
          ...and didn't come back. The link might be old, or there might be a typo in the address.
          Even my robot is lost.
        </p>
        <div class="flex flex-wrap justify-center md:justify-start gap-3">
          <a
            href="/"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-primary text-primary-foreground font-medium hover:opacity-90 transition-opacity focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
          >
            Take me home
          </a>
          <a
            href="/blog"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-border text-foreground font-medium hover:border-primary/60 hover:text-primary transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
          >
            Read the blog
          </a>
        </div>
      </div>
    </div>

    <div class="mt-16 md:mt-20">
      <h2 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-4">Maybe you were looking for</h2>
      <ul class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {latestPosts.map((post) => (
          <li>
            <a
              href={`/blog/${post.slug}`}
              class="block h-full bg-card rounded-2xl border border-border p-5 hover:border-primary/40 transition-colors"
            >
              <p class="font-medium text-foreground leading-snug mb-1">{post.data.title}</p>
              <p class="text-xs text-muted-foreground">
                {post.data.date.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" })}
              </p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

<style>
  .lost-robot {
    animation: bob 3s ease-in-out infinite;
  }
  @keyframes bob {
    50% { translate: 0 -8px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .lost-robot { animation: none; }
  }
</style>
